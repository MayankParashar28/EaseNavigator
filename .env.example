# Copy to .env and fill in. Never commit .env.

# --- Browser-side (bundled into the app; restrict these by domain) ---
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
VITE_OPENWEATHER_API_KEY=

# --- Server-side only (used by /api proxies; never bundled) ---
OCM_API_KEY=
GEMINI_API_KEY=

# --- Optional: API abuse protection ---
# Extra sites allowed to call /api/* (comma-separated), e.g. a custom domain.
ALLOWED_ORIGINS=
# Shared rate limiting across serverless instances (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
